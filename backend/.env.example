# ---------------------------------------------------------------------------
# Cấu hình backend VietRead — copy file này thành backend/.env rồi điền giá trị.
# File .env KHÔNG được commit lên git.
# ---------------------------------------------------------------------------

# --- SQL Server -------------------------------------------------------------
# Cách 1 (khuyến nghị cho máy chạy SQL Server cục bộ, Windows Authentication):
DATABASE_URL=mssql+pyodbc://./VietRead?trusted_connection=yes&driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Cách 2 (SQL Server Authentication — đúng định dạng trong đề bài):
# DATABASE_URL=mssql+pyodbc://<user>:<pass>@<server>/<database>?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# Ví dụ: mssql+pyodbc://sa:MatKhau123@localhost/VietRead?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# Lưu ý: nếu mật khẩu chứa ký tự đặc biệt (@ # ? % ...) hãy URL-encode nó.
# Ghi chú: driver 17 cũng đã cài trên máy này, đổi thành ODBC+Driver+17+for+SQL+Server nếu cần.

# --- JWT --------------------------------------------------------------------
# Chuỗi bí mật để ký token (vào https://randomkeygen.com để lấy chuỗi ngẫu nhiên)
SECRET_KEY=doi-chuoi-nay-thanh-chuoi-bi-mat-ngau-nhien
ALGORITHM=HS256
# Thời hạn token, tính theo phút (mặc định 7 ngày)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Khác -------------------------------------------------------------------
# Danh sách origin được phép gọi API (phân tách bằng dấu phẩy), mặc định "*"
CORS_ORIGINS=*

# --- Nhập truyện từ link (Bước 10) ------------------------------------------
# Chế độ dịch: dict (mặc định) = offline bằng từ điển backend/dictionaries/ —
# không cần mạng/key; online = chỉ API dịch; auto = online trước, lỗi rơi về dict
TRANSLATE_MODE=dict
# Chuỗi endpoint dịch dự phòng (không cần khoá):
#   TRANSLATE_API_URL (nếu đặt) → Google gtx → MyMemory.
# Endpoint lỗi >=2 lần liên tiếp tự tạm nghỉ rồi tự quay lại (5 phút với lỗi
# thường; hết quota thì nghỉ đúng tới thời điểm API báo hồi, tối đa 12 giờ)
# — không cần restart server. Xem app/services/translator.py
# Khoá API dịch (tuỳ chọn, chỉ dùng khi endpoint của bạn yêu cầu)
TRANSLATE_API_KEY=
# Đổi sang API dịch riêng nếu có (phản hồi dạng gtx hoặc { "translatedText" })
# TRANSLATE_API_URL=https://translate.googleapis.com/translate_a/single
# Email để MyMemory tăng hạn mức ngày 5000 → 50000 từ (tuỳ chọn)
# TRANSLATE_EMAIL=ban@email.com
# Delay giữa các request tới nguồn khi nhập chương (giây)
IMPORT_CHAPTER_DELAY=0.5
# Giới hạn số chương nhập cho mỗi job (0 = toàn bộ)
IMPORT_MAX_CHAPTERS=0
